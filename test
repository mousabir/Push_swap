#!/bin/bash
PS=./push_swap
CK=./checker
RUNS=${RUNS:-20}
pass=0; fail=0

ok(){ echo "[OK] $1"; ((pass++)); }
ko(){ echo "[KO] $1"; ((fail++)); }
gen(){ shuf -i 0-100000 -n "$1" | awk '{print $1-50000}' | tr '\n' ' '; }

echo "== errors (stderr must be exactly Error, stdout empty)"
check_err(){
	local e o
	e=$($PS "$@" 2>&1 >/dev/null)
	o=$($PS "$@" 2>/dev/null)
	if [ "$e" = "Error" ] && [ -z "$o" ]; then ok "error: $*"; else ko "error: $*"; fi
}
check_err 1 2 2
check_err a 1 2
check_err 1 2147483648
check_err -2147483649 1
check_err 1 +
check_err 1 -
check_err "" 1
check_err --simple 3 2 3
check_err --adaptive 0 one 2 3
check_err --simple --medium 3 2 1

echo "== no arguments"
[ -z "$($PS 2>&1)" ] && ok "no args prints nothing" || ko "no args prints nothing"

echo "== already sorted (must print nothing)"
for f in --simple --medium --complex --adaptive ""; do
	for a in "42" "1 2" "1 2 3 4 5"; do
		[ -z "$($PS $f $a)" ] && ok "sorted [$f] $a" || ko "sorted [$f] $a"
	done
done

echo "== sorted and reversed 100"
SORTED=$(seq 1 100 | tr '\n' ' ')
REV=$(seq 100 -1 1 | tr '\n' ' ')
for f in --simple --medium --complex --adaptive ""; do
	[ "$($PS $f $SORTED | $CK $SORTED)" = "OK" ] && ok "sorted100 [$f]" || ko "sorted100 [$f]"
	[ "$($PS $f $REV | $CK $REV)" = "OK" ] && ok "reverse100 [$f]" || ko "reverse100 [$f]"
done

run(){ # flag n limit(0 = no limit)
	local f=$1 n=$2 lim=$3 max=0 sum=0 bad=0 i arg ops res avg
	for ((i=0; i<RUNS; i++)); do
		arg=$(gen $n)
		$PS $f $arg > /tmp/ps_ops
		ops=$(wc -l < /tmp/ps_ops)
		res=$($CK $arg < /tmp/ps_ops)
		[ "$res" = "OK" ] || bad=1
		((ops > max)) && max=$ops
		sum=$((sum + ops))
	done
	avg=$((sum / RUNS))
	if [ $bad -eq 0 ] && { [ "$lim" -eq 0 ] || [ $max -lt $lim ]; }; then
		ok "n=$n [${f:-default}] avg=$avg max=$max (limit $lim)"
	else
		ko "n=$n [${f:-default}] avg=$avg max=$max (limit $lim) checker_bad=$bad"
	fi
}

echo "== small sizes, random"
for f in --simple --medium --complex --adaptive ""; do
	for n in 1 2 3 5 10; do run "$f" $n 0; done
done

echo "== benchmark (pass limits: 100 < 2000, 500 < 12000)"
run --simple 100 0
run --simple 500 0
for f in --medium --complex --adaptive ""; do
	run "$f" 100 2000
	run "$f" 500 12000
done

echo "== bench mode"
arg=$(gen 100)
$PS --bench $arg > /tmp/b_out 2> /tmp/b_err
[ -s /tmp/b_err ] && ok "bench text goes to stderr" || ko "bench text goes to stderr"
grep -qvxE 'sa|sb|ss|pa|pb|ra|rb|rr|rra|rrb|rrr' /tmp/b_out && ko "stdout has non-operation lines" || ok "stdout only operations"
grep -qi "disorder" /tmp/b_err && ok "bench shows disorder" || ko "bench shows disorder"
grep -qi "strategy" /tmp/b_err && ok "bench shows strategy" || ko "bench shows strategy"
$PS $arg 2>&1 >/dev/null | grep -q . && ko "stderr not empty without --bench" || ok "no stderr without --bench"

echo "== checker (bonus)"
[ "$(printf 'rra\npb\nsa\nrra\npa\n' | $CK 3 2 1 0)" = "OK" ] && ok "checker OK case" || ko "checker OK case"
[ "$(printf 'sa\nrra\npb\n' | $CK 3 2 1 0)" = "KO" ] && ok "checker KO case" || ko "checker KO case"
[ "$(printf 'xx\n' | $CK 3 2 1 0 2>&1)" = "Error" ] && ok "checker bad instruction" || ko "checker bad instruction"
[ "$($CK 3 2 one 0 2>&1 < /dev/null)" = "Error" ] && ok "checker non integer" || ko "checker non integer"
[ "$($CK "" 1 2>&1 < /dev/null)" = "Error" ] && ok "checker empty arg" || ko "checker empty arg"
[ -z "$($CK 2>&1 < /dev/null)" ] && ok "checker no args" || ko "checker no args"

echo "== leaks (needs valgrind)"
if command -v valgrind > /dev/null; then
	for f in --simple --medium --complex --adaptive; do
		valgrind -q --leak-check=full --error-exitcode=42 $PS $f $(gen 100) > /dev/null 2>&1
		[ $? -eq 42 ] && ko "leak [$f]" || ok "no leak [$f]"
	done
else
	echo "valgrind not installed, skipped"
fi

echo
echo "RESULT: $pass passed, $fail failed"
[ $fail -eq 0 ]